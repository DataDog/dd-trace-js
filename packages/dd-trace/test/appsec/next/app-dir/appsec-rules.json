{
  "version": "2.2",
  "metadata": {
    "rules_version": "1.5.0"
  },
  "rules": [
    {
      "id": "test-rule-id-1",
      "name": "test-rule-name-1",
      "tags": {
        "type": "security_scanner",
        "category": "attack_attempt"
      },
      "conditions": [
        {
          "parameters": {
            "inputs": [
              {
                "address": "server.request.query"
              },
              {
                "address": "server.request.body"
              }
            ],
            "list": [
              "testattack"
            ]
          },
          "operator": "phrase_match"
        }
      ],
      "transformers": ["lowercase"]
    },
    {
      "id": "test-rule-id-2",
      "name": "test-rule-name-2",
      "tags": {
        "type": "security_scanner",
        "category": "attack_attempt"
      },
      "conditions": [
        {
          "parameters": {
            "inputs": [
              {
                "address": "server.request.query"
              },
              {
                "address": "server.request.body"
              }
            ],
            "list": [
              "blockattack"
            ]
          },
          "operator": "phrase_match"
        }
      ],
      "transformers": ["lowercase"],
      "on_match": ["block"]
    },
    {
      "id": "test-rule-id-3",
      "name": "test-rule-name-3",
      "tags": {
        "type": "security_scanner",
        "category": "attack_attempt"
      },
      "conditions": [
        {
          "parameters": {
            "inputs": [
              {
                "address": "server.response.status"
              }
            ],
            "regex": "^404$"
          },
          "operator": "match_regex"
        },
        {
          "parameters": {
            "inputs": [
              {
                "address": "server.request.uri.raw"
              }
            ],
            "regex": "blockresponse"
          },
          "operator": "match_regex"
        }
      ],
      "transformers": [],
      "on_match": ["block"]
    }
  ]
}
