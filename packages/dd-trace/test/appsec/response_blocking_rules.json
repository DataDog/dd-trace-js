{
  "version": "2.2",
  "metadata": {
    "rules_version": "1.5.0"
  },
  "rules": [
    {
      "id": "test-rule-id-1",
      "name": "test-rule-name-1",
      "tags": {
        "type": "security_scanner1",
        "category": "attack_attempt1"
      },
      "conditions": [
        {
          "operator": "match_regex",
          "parameters": {
            "inputs": [
              {
                "address": "server.response.status"
              }
            ],
            "regex": "^404$",
            "options": {
              "case_sensitive": true
            }
          }
        },
        {
          "operator": "match_regex",
          "parameters": {
            "inputs": [
              {
                "address": "server.response.headers.no_cookies"
              }
            ],
            "regex": "^404$",
            "options": {
              "case_sensitive": false
            }
          }
        }
      ],
      "transformers": [
        "lowercase"
      ],
      "on_match": [
        "block"
      ]
    },
    {
      "id": "test-rule-id-2",
      "name": "test-rule-name-2",
      "tags": {
        "type": "security_scanner2",
        "category": "attack_attempt2"
      },
      "conditions": [
        {
          "operator": "match_regex",
          "parameters": {
            "inputs": [
              {
                "address": "server.response.headers.no_cookies"
              }
            ],
            "regex": "^bad1$",
            "options": {
              "case_sensitive": false
            }
          }
        },
        {
          "operator": "match_regex",
          "parameters": {
            "inputs": [
              {
                "address": "server.response.headers.no_cookies"
              }
            ],
            "regex": "^bad2$",
            "options": {
              "case_sensitive": false
            }
          }
        },
        {
          "operator": "match_regex",
          "parameters": {
            "inputs": [
              {
                "address": "server.response.headers.no_cookies"
              }
            ],
            "regex": "^bad3$",
            "options": {
              "case_sensitive": false
            }
          }
        }
      ],
      "transformers": [
        "lowercase"
      ],
      "on_match": [
        "block"
      ]
    },
    {
      "id": "implicit-http2-response",
      "name": "implicit HTTP/2 response",
      "tags": {
        "type": "security_scanner5",
        "category": "attack_attempt5"
      },
      "conditions": [
        {
          "operator": "match_regex",
          "parameters": {
            "inputs": [
              {
                "address": "server.request.uri.raw"
              }
            ],
            "regex": "^/implicit-response$",
            "options": {
              "case_sensitive": true
            }
          }
        },
        {
          "operator": "match_regex",
          "parameters": {
            "inputs": [
              {
                "address": "server.response.status"
              }
            ],
            "regex": "^200$",
            "options": {
              "case_sensitive": true
            }
          }
        }
      ],
      "on_match": [
        "block"
      ]
    },
    {
      "id": "mixed-http2-context",
      "name": "mixed HTTP/2 context continuity",
      "tags": {
        "type": "security_scanner3",
        "category": "attack_attempt3"
      },
      "conditions": [
        {
          "operator": "match_regex",
          "parameters": {
            "inputs": [
              {
                "address": "server.request.uri.raw"
              }
            ],
            "regex": "^/mixed-context$",
            "options": {
              "case_sensitive": true
            }
          }
        },
        {
          "operator": "phrase_match",
          "parameters": {
            "inputs": [
              {
                "address": "server.request.body"
              }
            ],
            "list": [
              "mixed-context-body"
            ]
          }
        },
        {
          "operator": "phrase_match",
          "parameters": {
            "inputs": [
              {
                "address": "server.request.cookies"
              }
            ],
            "list": [
              "mixed-context-cookie"
            ]
          }
        },
        {
          "operator": "phrase_match",
          "parameters": {
            "inputs": [
              {
                "address": "server.request.query"
              }
            ],
            "list": [
              "mixed-context-query"
            ]
          }
        },
        {
          "operator": "phrase_match",
          "parameters": {
            "inputs": [
              {
                "address": "server.request.path_params"
              }
            ],
            "list": [
              "mixed-context-param"
            ]
          }
        },
        {
          "operator": "phrase_match",
          "parameters": {
            "inputs": [
              {
                "address": "server.response.body"
              }
            ],
            "list": [
              "mixed-context-response"
            ]
          }
        }
      ],
      "transformers": [
        "lowercase"
      ]
    },
    {
      "id": "mixed-http2-session",
      "name": "mixed HTTP/2 session context continuity",
      "tags": {
        "type": "security_scanner4",
        "category": "attack_attempt4"
      },
      "conditions": [
        {
          "operator": "match_regex",
          "parameters": {
            "inputs": [
              {
                "address": "server.request.uri.raw"
              }
            ],
            "regex": "^/mixed-session$",
            "options": {
              "case_sensitive": true
            }
          }
        },
        {
          "operator": "match_regex",
          "parameters": {
            "inputs": [
              {
                "address": "usr.session_id"
              }
            ],
            "regex": "^mixed-http2-session$",
            "options": {
              "case_sensitive": true
            }
          }
        }
      ],
      "on_match": [
        "block"
      ]
    },
    {
      "id": "corked-http2-redirect",
      "name": "corked HTTP/2 redirect",
      "tags": {
        "type": "security_scanner6",
        "category": "attack_attempt6"
      },
      "conditions": [
        {
          "operator": "match_regex",
          "parameters": {
            "inputs": [
              {
                "address": "server.request.uri.raw"
              }
            ],
            "regex": "^/corked-redirect(?:-writev)?$",
            "options": {
              "case_sensitive": true
            }
          }
        },
        {
          "operator": "match_regex",
          "parameters": {
            "inputs": [
              {
                "address": "server.response.status"
              }
            ],
            "regex": "^404$",
            "options": {
              "case_sensitive": true
            }
          }
        }
      ],
      "on_match": [
        "redirect"
      ]
    },
    {
      "id": "invalid-http2-redirect",
      "name": "invalid HTTP/2 redirect",
      "tags": {
        "type": "security_scanner7",
        "category": "attack_attempt7"
      },
      "conditions": [
        {
          "operator": "match_regex",
          "parameters": {
            "inputs": [
              {
                "address": "server.request.uri.raw"
              }
            ],
            "regex": "^/invalid-block-response$",
            "options": {
              "case_sensitive": true
            }
          }
        },
        {
          "operator": "match_regex",
          "parameters": {
            "inputs": [
              {
                "address": "server.response.status"
              }
            ],
            "regex": "^404$",
            "options": {
              "case_sensitive": true
            }
          }
        }
      ],
      "on_match": [
        "invalid-block"
      ]
    }
  ],
  "actions": [
    {
      "id": "redirect",
      "type": "redirect_request",
      "parameters": {
        "status_code": 302,
        "location": "/blocked"
      }
    },
    {
      "id": "invalid-block",
      "type": "block_request",
      "parameters": {
        "status_code": 101,
        "type": "auto"
      }
    }
  ]
}
