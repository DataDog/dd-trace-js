{
  "version": "2.2",
  "metadata": {
    "rules_version": "1.0.0"
  },
  "rules": [
    {
      "id": "test-response-status-rule",
      "name": "Block responses with a 404 status",
      "tags": {
        "type": "security_scanner",
        "category": "attack_attempt"
      },
      "conditions": [
        {
          "operator": "match_regex",
          "parameters": {
            "inputs": [
              {
                "address": "server.response.status"
              }
            ],
            "regex": "^404$"
          }
        }
      ],
      "transformers": [],
      "on_match": ["block"]
    },
    {
      "id": "test-response-header-rule",
      "name": "Block responses with a blocked header value",
      "tags": {
        "type": "security_scanner",
        "category": "attack_attempt"
      },
      "conditions": [
        {
          "operator": "match_regex",
          "parameters": {
            "inputs": [
              {
                "address": "server.response.headers.no_cookies"
              }
            ],
            "regex": "^blockresponse$"
          }
        }
      ],
      "transformers": [],
      "on_match": ["block"]
    }
  ]
}
