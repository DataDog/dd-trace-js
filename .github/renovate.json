{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "bun"
  ],
  "includePaths": [
    "package.json",
    "bun.lock",
    "docs/package.json",
    "docs/bun.lock",
    ".github/actions/datadog-ci/package.json",
    ".github/actions/datadog-ci/bun.lock",
    "vendor/package.json",
    "vendor/bun.lock",
    ".github/all-green/package.json",
    ".github/all-green/bun.lock"
  ],
  "timezone": "UTC",
  "dependencyDashboard": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "rebaseWhen": "behind-base-branch",
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "osvVulnerabilityAlerts": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 0-4 * * 0"
    ]
  },
  "packageRules": [
    {
      "description": "Disable regular dependency updates",
      "matchManagers": [
        "bun"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "rollback",
        "bump",
        "replacement"
      ],
      "enabled": false
    },
    {
      "description": "Automerge Sunday lockfile maintenance",
      "matchManagers": [
        "bun"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "groupSingleUpdates": true,
      "automerge": true,
      "labels": [
        "dependencies",
        "javascript",
        "semver-patch"
      ]
    },
    {
      "description": "Root lockfile maintenance",
      "matchManagers": [
        "bun"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "matchFileNames": [
        "package.json"
      ],
      "groupName": "root lockfile maintenance",
      "groupSlug": "root-lockfile-maintenance"
    },
    {
      "description": "Docs lockfile maintenance",
      "matchManagers": [
        "bun"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "matchFileNames": [
        "docs/package.json"
      ],
      "groupName": "docs lockfile maintenance",
      "groupSlug": "docs-lockfile-maintenance"
    },
    {
      "description": "datadog-ci action lockfile maintenance",
      "matchManagers": [
        "bun"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "matchFileNames": [
        ".github/actions/datadog-ci/package.json"
      ],
      "groupName": "datadog-ci action lockfile maintenance",
      "groupSlug": "datadog-ci-action-lockfile-maintenance"
    },
    {
      "description": "Vendor lockfile maintenance",
      "matchManagers": [
        "bun"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "matchFileNames": [
        "vendor/package.json"
      ],
      "groupName": "vendor lockfile maintenance",
      "groupSlug": "vendor-lockfile-maintenance"
    },
    {
      "description": "All-green lockfile maintenance",
      "matchManagers": [
        "bun"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "matchFileNames": [
        ".github/all-green/package.json"
      ],
      "groupName": "all-green lockfile maintenance",
      "groupSlug": "all-green-lockfile-maintenance"
    }
  ]
}
