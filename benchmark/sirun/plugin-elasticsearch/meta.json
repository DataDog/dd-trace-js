{
  "name": "plugin-elasticsearch",
  "run": "node --no-lazy --predictable --predictable-gc-schedule index.js",
  "run_with_affinity": "bash -c \"taskset -c $CPU_AFFINITY node --no-lazy --predictable --predictable-gc-schedule index.js\"",
  "cachegrind": false,
  "iterations": 12,
  "instructions": true,
  "variants": {
    "search": {
      "iterations": 10,
      "env": { "VARIANT": "search", "OPERATIONS": "2700000" }
    },
    "bulk-index": {
      "env": { "VARIANT": "bulk-index", "OPERATIONS": "230000" }
    },
    "get": {
      "env": { "VARIANT": "get", "OPERATIONS": "5400000" }
    }
  }
}
