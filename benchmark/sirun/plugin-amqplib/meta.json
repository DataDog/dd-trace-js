{
  "name": "plugin-amqplib",
  "run": "node index.js",
  "run_with_affinity": "bash -c \"taskset -c $CPU_AFFINITY node index.js\"",
  "cachegrind": false,
  "iterations": 10,
  "instructions": true,
  "variants": {
    "publish": { "env": { "VARIANT": "publish", "OPERATIONS": "2000000" } },
    "publish-churn": { "env": { "VARIANT": "publish-churn", "OPERATIONS": "2000000" } },
    "consume": { "env": { "VARIANT": "consume", "OPERATIONS": "2000000" } }
  }
}
