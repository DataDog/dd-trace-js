{
  "name": "llmobs-exporter-buffer",
  "run": "node --expose-gc index.js",
  "run_with_affinity": "bash -c \"taskset -c $CPU_AFFINITY node --expose-gc index.js\"",
  "cachegrind": false,
  "iterations": 12,
  "instructions": true,
  "variants": {
    "fill": {
      "env": { "OPERATIONS": "1000" }
    },
    "evict": {
      "env": { "OPERATIONS": "10000" }
    }
  }
}
