{
  "name": "instrument-get-hooks",
  "run": "node index.js",
  "run_with_affinity": "bash -c \"taskset -c $CPU_AFFINITY node index.js\"",
  "cachegrind": false,
  "instructions": true,
  "iterations": 10,
  "variants": {
    "scan": {
      "env": {
        "SCAN": "1",
        "STARTUPS": "20000",
        "OPERATIONS": "20000"
      }
    },
    "indexed": {
      "env": {
        "STARTUPS": "20000",
        "OPERATIONS": "20000"
      }
    }
  }
}
