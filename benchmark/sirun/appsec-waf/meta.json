{
  "name": "appsec-waf",
  "run": "node index.js",
  "run_with_affinity": "bash -c \"taskset -c $CPU_AFFINITY node index.js\"",
  "cachegrind": false,
  "iterations": 20,
  "instructions": true,
  "variants": {
    "request": {
      "iterations": 13,
      "env": {
        "WAF_SAMPLE": "request",
        "OPERATIONS": "50000"
      }
    },
    "attack": {
      "iterations": 14,
      "env": {
        "WAF_SAMPLE": "attack",
        "OPERATIONS": "28000"
      }
    }
  }
}
