{
  "name": "openfeature",
  "run": "node index.js",
  "run_with_affinity": "bash -c \"taskset -c $CPU_AFFINITY node index.js\"",
  "cachegrind": false,
  "iterations": 5,
  "instructions": true,
  "variants": {
    "typical": {
      "operations_by_node": {
        "20": "275000"
      },
      "env": {
        "VARIANT": "typical",
        "CONSENT": "false",
        "OPERATIONS": "550000"
      }
    },
    "typical-full": {
      "operations_by_node": {
        "20": "245000"
      },
      "env": {
        "VARIANT": "typical",
        "CONSENT": "true",
        "OPERATIONS": "450000"
      }
    },
    "scale-full": {
      "operations_by_node": {
        "20": "4000"
      },
      "env": {
        "VARIANT": "scale",
        "CONSENT": "true",
        "OPERATIONS": "26000",
        "WARMUP": "100"
      }
    },
    "stress-full": {
      "env": {
        "VARIANT": "stress",
        "CONSENT": "true",
        "OPERATIONS": "600",
        "WARMUP": "10"
      }
    }
  }
}
