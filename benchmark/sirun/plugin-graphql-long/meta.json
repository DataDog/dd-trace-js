{
  "name": "plugin-graphql-long",
  "run": "node index.js",
  "run_with_affinity": "bash -c \"taskset -c $CPU_AFFINITY node index.js\"",
  "cachegrind": false,
  "iterations": 5,
  "instructions": true,
  "variants": {
    "with-depth-off": {
      "operations_by_node": {
        "20": "1825",
        "24": "3650"
      },
      "env": {
        "DEPTH": "0",
        "DD_REMOTE_CONFIGURATION_ENABLED": "false",
        "OPERATIONS": "3650",
        "WITH_TRACER": "1"
      }
    },
    "with-depth-on-max": {
      "operations_by_node": {
        "20": "1200",
        "24": "2400"
      },
      "env": {
        "COLLAPSE": "1",
        "DD_REMOTE_CONFIGURATION_ENABLED": "false",
        "OPERATIONS": "2600",
        "DEPTH": "6",
        "WITH_TRACER": "1"
      }
    },
    "with-depth-and-collapse-off": {
      "run": "node --predictable-gc-schedule index.js",
      "run_with_affinity": "bash -c \"taskset -c $CPU_AFFINITY node --predictable-gc-schedule index.js\"",
      "operations_by_node": {
        "20": "400",
        "24": "600"
      },
      "env": {
        "COLLAPSE": "0",
        "DD_REMOTE_CONFIGURATION_ENABLED": "false",
        "OPERATIONS": "600",
        "DEPTH": "4",
        "WITH_TRACER": "1"
      }
    }
  }
}
