{
  "name": "plugin-graphql-long",
  "run": "node --require ../noop-request.js index.js",
  "run_with_affinity": "bash -c \"taskset -c $CPU_AFFINITY node --require ../noop-request.js index.js\"",
  "cachegrind": false,
  "iterations": 10,
  "instructions": true,
  "variants": {
    "with-depth-off": {
      "operations_by_node": {
        "20": "1280",
        "24": "2550"
      },
      "env": {
        "DEPTH": "0",
        "DD_INJECT_FORCE": "true",
        "DD_REMOTE_CONFIGURATION_ENABLED": "false",
        "DD_TRACE_ENABLED": "true",
        "OPERATIONS": "2550",
        "OTEL_TRACES_EXPORTER": "none",
        "WITH_TRACER": "1"
      }
    },
    "with-depth-on-max": {
      "operations_by_node": {
        "20": "840",
        "24": "1680"
      },
      "env": {
        "COLLAPSE": "1",
        "DD_INJECT_FORCE": "true",
        "DD_REMOTE_CONFIGURATION_ENABLED": "false",
        "DD_TRACE_ENABLED": "true",
        "OPERATIONS": "1820",
        "OTEL_TRACES_EXPORTER": "none",
        "DEPTH": "6",
        "WITH_TRACER": "1"
      }
    },
    "with-depth-and-collapse-off": {
      "operations_by_node": {
        "20": "310",
        "24": "450"
      },
      "env": {
        "COLLAPSE": "0",
        "DD_INJECT_FORCE": "true",
        "DD_REMOTE_CONFIGURATION_ENABLED": "false",
        "DD_TRACE_ENABLED": "true",
        "OPERATIONS": "350",
        "OTEL_TRACES_EXPORTER": "none",
        "DEPTH": "4",
        "WITH_TRACER": "1"
      }
    }
  }
}
